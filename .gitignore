data/processed/counts.csv
data/processed/normalized_counts.csv
data/processed/model_ready_counts.csv
data/processed/gencode_v44_gene_biotypes.csv
# public reference + raw sequencing are never committed
data/external/gencode/
data/external/**/work/
*.fastq
*.fastq.gz
*.fq.gz
# NOTE: curated external analysis inputs ARE committed on purpose:
#   data/external/matia2024/  (validation tables)  and
#   data/external/yang_moss_2015/ (ingestion scripts + filereport)

# --- results: commit PNG + CSV outputs; skip the heavy vector duplicates ---
results/**/*.pdf
results/**/*.svg
results/tables/dge_results_full.csv
