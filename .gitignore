# --- environments, caches, build artifacts (regenerable) ---
venv/
__pycache__/
*.pyc
.DS_Store
.pytest_cache/
.mypy_cache/
.mplcache/
build/
release/
*.zip

# --- large / regenerable INPUT data (re-downloaded by the scripts; see docs/SOURCES.md) ---
data/raw/
